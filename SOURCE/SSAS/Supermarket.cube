  <Source dwd:design-time-name="a9c9cd71-4091-4c84-a5c3-9b6eaaa5dbd6">
    <DataSourceViewID>Supermarket</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="9f17d426-33e4-45d3-93cc-d7f7615b0f7f">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;   
CREATE DYNAMIC SET CURRENTCUBE.[Cau_11]
 AS TOPCOUNT( [Dim Sale Rep].[Sales Rep].Children,3, [Measures].[Units Sold]);     
CREATE MEMBER CURRENTCUBE.[Measures].Avg_of_Order
 AS [Measures].[Revenue] / [Measures].[Fact Count], 
FORMAT_STRING = "Standard", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact'; 
CREATE DYNAMIC SET CURRENTCUBE.[Cau_13]
 AS FILTER([Dim Sale Rep].[Sales Rep].[Sales Rep].MEMBERS,[Measures].[Fact Count] &lt; 850) ;      
CREATE MEMBER CURRENTCUBE.[Measures].Percentage
 AS [Measures].[Revenue] / [Measures].[Target], 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact';  
CREATE DYNAMIC SET CURRENTCUBE.[Cau_12]
 AS FILTER([Dim Time].[Year].[Year].MEMBERS, [Measures].[Revenue] &gt;= 630000);       
CREATE DYNAMIC SET CURRENTCUBE.[Cau_4]
 AS DRILLDOWNLEVEL( { [Dim Time].[Hierarchy].[Year].&amp;[2023] } );        
CREATE DYNAMIC SET CURRENTCUBE.[Cau_3]
 AS DRILLDOWNLEVEL( { [Dim Location].[Hierarchy].[Region].[North] } );          
CREATE DYNAMIC SET CURRENTCUBE.[Cau_1]
 AS NONEMPTY([Dim Time].[Hierarchy].[Year].Members);          
CREATE MEMBER CURRENTCUBE.[Measures].Roll_Up_Month_To_Year
 AS SUM(
            Descendants(
                [Dim Time].[Hierarchy].CurrentMember,
                [Dim Time].[Hierarchy].[Month]
            ),
            [Measures].[Revenue]
          ), 
FORMAT_STRING = "Currency", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact';         
CREATE DYNAMIC SET CURRENTCUBE.[Cau_2]
 AS NONEMPTY( [Dim Product].[Hierarchy].[Product Category].Members );    
CREATE DYNAMIC SET CURRENTCUBE.[Cau_10]
 AS TOPCOUNT( [Dim Product].[Product Category].children,1,[Measures].[Units Sold]);         
CREATE MEMBER CURRENTCUBE.[Measures].Roll_Up_ProName_To_ProCategory
 AS SUM(
    DESCENDANTS(
        [Dim Product].[Hierarchy].CurrentMember,   
        [Dim Product].[Hierarchy].[Product Name]   
    ),
    [Measures].[Units Sold]                        
   ), 
FORMAT_STRING = "Standard", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact'; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>