          SQLTask:SqlStatementSource="IF EXISTS (SELECT 1 FROM sys.foreign_keys WHERE name = 'FK_FACT_Dim_Time')&#xA;    ALTER TABLE Fact DROP CONSTRAINT FK_FACT_Dim_Time;&#xA;&#xA;IF EXISTS (SELECT 1 FROM sys.foreign_keys WHERE name = 'FK_FACT_Dim_Customer')&#xA;    ALTER TABLE Fact DROP CONSTRAINT FK_FACT_Dim_Customer;&#xA;&#xA;IF EXISTS (SELECT 1 FROM sys.foreign_keys WHERE name = 'FK_FACT_Dim_Product')&#xA;    ALTER TABLE Fact DROP CONSTRAINT FK_FACT_Dim_Product;&#xA;&#xA;IF EXISTS (SELECT 1 FROM sys.foreign_keys WHERE name = 'FK_FACT_Dim_Location')&#xA;    ALTER TABLE Fact DROP CONSTRAINT FK_FACT_Dim_Location;&#xA;&#xA;IF EXISTS (SELECT 1 FROM sys.foreign_keys WHERE name = 'FK_FACT_Dim_SaleRep')&#xA;    ALTER TABLE Fact DROP CONSTRAINT FK_FACT_Dim_SaleRep;&#xA;&#xA;TRUNCATE TABLE Fact_1;&#xA;TRUNCATE TABLE Fact_2;&#xA;TRUNCATE TABLE Fact_3;&#xA;TRUNCATE TABLE Fact;&#xA;TRUNCATE TABLE Dim_Time;&#xA;TRUNCATE TABLE Fact_Raw;&#xA;TRUNCATE TABLE Dim_Product;&#xA;TRUNCATE TABLE Dim_SaleRep;&#xA;TRUNCATE TABLE Dim_Customer;&#xA;TRUNCATE TABLE Dim_Location;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
